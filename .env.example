# ==============================================================================
# Sports Play Analyzer — Environment Configuration Template
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Public origin of the app; the OAuth redirect URI is APP_ORIGIN + /auth/callback
APP_ORIGIN=http://localhost:8000

# Security & Sessions
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
# true in production (cookie __Host-sid, Secure); false for local http (cookie sid)
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Extra origins allowed to send POST/PUT/DELETE (CSRF check); APP_ORIGIN is always allowed.
# Local dev with the Vite server on :5173 needs it here.
TRUSTED_ORIGINS=http://localhost:5173

# Database (Postgres 16; the +psycopg driver suffix is required, add ?sslmode=require for Neon)
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/sports_analyzer

# Google OAuth 2.0 (Authorization Code Flow with PKCE)
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
# Authorized redirect URI to register in Google Cloud Console: http://localhost:8000/auth/callback

# Storage Backend: "local" (disk) or "s3" (Cloudflare R2 / Tigris / AWS S3).
# Production must use s3: web and worker run on different machines.
BLOB_BACKEND=local
# Defaults to <repo>/blobs outside Docker; the image and compose use /app/blobs.
# BLOB_LOCAL_DIR=

# S3 Configuration (bucket + keys required if BLOB_BACKEND=s3; endpoint empty = AWS)
S3_ENDPOINT_URL=
S3_BUCKET=sports-analyzer-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Job queue: lease held by a worker, extended by heartbeats; WORKER_ID defaults to hostname-pid
LEASE_SECONDS=60
# WORKER_ID=

# Detector: YOLOX-S ONNX (the Docker image sets MODEL_PATH=/models/yolox_s.onnx; locally put the
# file at backend/../models/yolox_s.onnx or point MODEL_PATH at it). Players are kept down to
# TRACKER_LOW_THRESH (tracker stage 2); the small ball has its own threshold; max one ball/frame.
# MODEL_PATH=
DETECT_INPUT_SIZE=640
BALL_CONF_THRESHOLD=0.15
NMS_THRESHOLD=0.45
DETECT_MAX_CANDIDATES=300
# ONNX Runtime CPU threads (0 = one per core)
ORT_THREADS=0
# Tracker (ByteTrack-style). Ages/hits count *sampled* frames: 10 at SAMPLE_FPS=5 = 2 s.
# Scores >= HIGH start/match tracks; LOW..HIGH only keep existing tracks alive.
TRACKER_HIGH_THRESH=0.5
TRACKER_LOW_THRESH=0.1
TRACKER_IOU_THRESHOLD=0.3
TRACKER_LOW_IOU=0.5
TRACKER_MAX_AGE=10
TRACKER_MIN_HITS=3
# Ignore boxes smaller than this fraction of the frame area
MIN_BOX_AREA_REL=0.0005

# Metrics: feet moves under JITTER_PX are detector wobble; heatmap grid size;
# possession = ball within RATIO x player box height of the feet for MIN_FRAMES in a row
JITTER_PX=2.0
HEATMAP_GRID_W=32
HEATMAP_GRID_H=18
POSSESSION_DIST_RATIO=0.5
POSSESSION_MIN_FRAMES=3
# Jersey-colour clusters closer than this are indistinguishable -> every team "unknown"
TEAM_MIN_SEPARATION=0.2

# Video decode/encode: frames analysed per second (annotated video plays at this rate),
# long-side cap for decoded frames, and libx264 quality/speed for the annotated output
SAMPLE_FPS=5
MAX_FRAME_SIDE=1280
ENCODE_CRF=26
ENCODE_PRESET=veryfast

# Ingestion Limits
MAX_VIDEO_DURATION_SECONDS=60
MAX_UPLOAD_SIZE_BYTES=104857600
# Where per-request upload temp dirs are created (default: system temp dir)
# UPLOAD_TMP_DIR=
RATE_LIMIT_PER_MINUTE=10
MAX_ACTIVE_JOBS_PER_USER=3

# Optional mitigations when YouTube blocks the server's IP (see D-010 / D-020).
# YTDLP_COOKIES_B64: base64 of a Netscape cookies.txt from a throwaway account (secret!)
# YTDLP_PROXY: proxy URL used for both yt-dlp and the media download
YTDLP_COOKIES_B64=
YTDLP_PROXY=
