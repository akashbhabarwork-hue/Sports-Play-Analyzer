# ==============================================================================
# Sports Play Analyzer — Environment Configuration Template
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
BASE_URL=http://localhost:8000

# Security & Sessions
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Database (Postgres 16 connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_analyzer

# Google OAuth 2.0 (Authorization Code Flow with PKCE)
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Storage Backend: "local" (disk) or "s3" (Cloudflare R2 / Tigris / AWS S3)
BLOB_BACKEND=local
BLOB_LOCAL_DIR=/data/blobs

# S3 Configuration (required if BLOB_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET=sports-analyzer-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Vision Pipeline & Worker Tunables
SAMPLE_FPS=5
DETECT_INPUT_SIZE=640
CONF_THRESHOLD=0.35
NMS_THRESHOLD=0.45
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=3
TRACKER_IOU_THRESHOLD=0.3

# Ingestion Limits
MAX_VIDEO_DURATION_SECONDS=60
MAX_UPLOAD_SIZE_BYTES=104857600
RATE_LIMIT_PER_MINUTE=10
MAX_ACTIVE_JOBS_PER_USER=3

# Optional YouTube download proxy / cookies
YOUTUBE_COOKIE_FILE=
YOUTUBE_PROXY=
